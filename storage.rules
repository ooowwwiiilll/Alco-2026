rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    match /assets/{uid}/{id} {
      allow read: if approved();
      allow create: if resource == null && approved() && request.auth.uid == uid &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
