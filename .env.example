# Copy to .env.local (never committed).

# Local development: isolated workspace stored in this browser (IndexedDB), demo profiles enabled.
VITE_DATA_MODE=local

# Shared team workspace: real accounts on the team Firebase project.
# VITE_DATA_MODE=firebase
# VITE_FIREBASE_CONFIG='{"apiKey":"...","projectId":"...","appId":"...","authDomain":"PROJECT.firebaseapp.com","storageBucket":"PROJECT.firebasestorage.app"}'

# Production builds always use Firebase and never offer demo profiles.
