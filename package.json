{
  "name": "alco",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "NODE_ENV=production node build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "test:rules": "node --import tsx --test tests/rules/*.test.ts",
    "format": "prettier --write src tests server.ts vite.config.ts playwright.production.config.ts",
    "format:check": "prettier --check src tests server.ts vite.config.ts playwright.production.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "^2.5.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "description": "ALCO \u2014 Aleph Layout & Content Orchestrator: assembles reviewable website previews from a governed component library."
}
